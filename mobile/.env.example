# Copy to .env for local development. EAS builds take EXPO_PUBLIC_API_URL from eas.json instead.
# Only put values here that are safe to ship inside the app: EXPO_PUBLIC_* variables are readable by anyone.

# API base URL. On a real phone use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.x.x:4000

# Map style. OpenFreeMap needs no account or key.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
