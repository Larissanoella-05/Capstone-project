# Copy this file to .env and adjust the values.

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/umuriro?schema=public"

# Port the API listens on
PORT=4000

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
# Login length for the Android app (it sends client: "mobile")
JWT_EXPIRES_IN_MOBILE="30d"

# SMS gateway for "report received" and "technician assigned" messages (and, for guest reports, every status): log (default, writes to the API log only)
# smsgate (an Android phone running SMS Gateway for Android, see docs/DEPLOYMENT.md) or africastalking (not implemented yet).
# With log, no SMS is really sent.
SMS_PROVIDER=log
# Only for smsgate. Cloud relay shown; for local mode use the address the phone app shows, e.g. http://192.168.1.20:8080
# SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
# SMS_GATEWAY_USER=
# SMS_GATEWAY_PASSWORD=

# Address of the web app. The tracking link sent to a guest is built from it.
PUBLIC_WEB_URL="http://localhost:5173"

# Optional: Expo access token, only if "enhanced push security" is turned on in your Expo account.
# Push notifications also need the Firebase (FCM V1) credentials uploaded to EAS: see the mobile section of the README.
# Without them the API still works; pushes just fail quietly and are logged as "[push] ...".
EXPO_ACCESS_TOKEN=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
