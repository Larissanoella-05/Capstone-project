# Copy this file to .env and adjust the values.

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/umuriro?schema=public"

# Port the API listens on
PORT=4000

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
